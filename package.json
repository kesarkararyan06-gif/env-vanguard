{
  "name": "env-vanguard",
  "version": "0.1.0",
  "description": "Zero-dependency environment variable validator. Validates process.env against a schema at startup, aggregates all errors, and generates .env.example files.",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "require": "./src/index.js",
      "import": "./src/index.mjs",
      "types": "./src/index.d.ts"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "jest --coverage",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "prepublishOnly": "npm run lint && npm test",
    "example:basic": "node examples/basic.js",
    "example:advanced": "node examples/advanced.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "env",
    "environment",
    "validation",
    "variables",
    "config",
    "schema",
    "startup",
    "dotenv",
    "12factor",
    "zero-dependency"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/GITHUB_USERNAME/env-vanguard/issues"
  },
  "homepage": "https://github.com/GITHUB_USERNAME/env-vanguard#readme",
  "devDependencies": {
    "eslint": "^9.0.0",
    "jest": "^29.7.0"
  }
}
